const complex_type Dgprl_coeff_gprr = (Iup * Iup)*gqll*(z2 * z2)*conj(gqlr)*(conj(z1) * conj(z1)) + (Iup * Iup)*gqrl*(z2 * z2)*conj(gqrr)*(conj(z1) * conj(z1)) ; 
