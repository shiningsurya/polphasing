I
\left(- g_p^{ll} \overline{g_q^{ll}} - g_p^{lr} \overline{g_q^{lr}}\right) \overline{d_{pq}^{ll}}+\left(- g_p^{ll} \overline{g_q^{rl}} - g_p^{lr} \overline{g_q^{rr}}\right) \overline{d_{pq}^{lr}}+\left(- g_p^{rl} \overline{g_q^{ll}} - g_p^{rr} \overline{g_q^{lr}}\right) \overline{d_{pq}^{rl}}+\left(- g_p^{rl} \overline{g_q^{rl}} - g_p^{rr} \overline{g_q^{rr}}\right) \overline{d_{pq}^{rr}}+d_{pq}^{lr} \left(- g_q^{rl} \overline{g_p^{ll}} - g_q^{rr} \overline{g_p^{lr}}\right)+d_{pq}^{ll} \left(- g_q^{ll} \overline{g_p^{ll}} - g_q^{lr} \overline{g_p^{lr}}\right)+d_{pq}^{rr} \left(- g_q^{rl} \overline{g_p^{rl}} - g_q^{rr} \overline{g_p^{rr}}\right)+d_{pq}^{rl} \left(- g_q^{ll} \overline{g_p^{rl}} - g_q^{lr} \overline{g_p^{rr}}\right)+2 I_{up} g_p^{ll} g_q^{ll} \overline{g_p^{ll}} \overline{g_q^{ll}} + 2 I_{up} g_p^{ll} g_q^{lr} \overline{g_p^{lr}} \overline{g_q^{ll}} + 2 I_{up} g_p^{ll} g_q^{rl} \overline{g_p^{ll}} \overline{g_q^{rl}} + 2 I_{up} g_p^{ll} g_q^{rr} \overline{g_p^{lr}} \overline{g_q^{rl}} + 2 I_{up} g_p^{lr} g_q^{ll} \overline{g_p^{ll}} \overline{g_q^{lr}} + 2 I_{up} g_p^{lr} g_q^{lr} \overline{g_p^{lr}} \overline{g_q^{lr}} + 2 I_{up} g_p^{lr} g_q^{rl} \overline{g_p^{ll}} \overline{g_q^{rr}} + 2 I_{up} g_p^{lr} g_q^{rr} \overline{g_p^{lr}} \overline{g_q^{rr}} + 2 I_{up} g_p^{rl} g_q^{ll} \overline{g_p^{rl}} \overline{g_q^{ll}} + 2 I_{up} g_p^{rl} g_q^{lr} \overline{g_p^{rr}} \overline{g_q^{ll}} + 2 I_{up} g_p^{rl} g_q^{rl} \overline{g_p^{rl}} \overline{g_q^{rl}} + 2 I_{up} g_p^{rl} g_q^{rr} \overline{g_p^{rr}} \overline{g_q^{rl}} + 2 I_{up} g_p^{rr} g_q^{ll} \overline{g_p^{rl}} \overline{g_q^{lr}} + 2 I_{up} g_p^{rr} g_q^{lr} \overline{g_p^{rr}} \overline{g_q^{lr}} + 2 I_{up} g_p^{rr} g_q^{rl} \overline{g_p^{rl}} \overline{g_q^{rr}} + 2 I_{up} g_p^{rr} g_q^{rr} \overline{g_p^{rr}} \overline{g_q^{rr}}
