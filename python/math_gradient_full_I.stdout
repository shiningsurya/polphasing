-------------------------
const complex_type Dgqrr_coeff_gqrl = (Iup * Iup)*gplr*(z2 * z2)*conj(gpll)*(conj(z1) * conj(z1)) + (Iup * Iup)*gprr*(z2 * z2)*conj(gprl)*(conj(z1) * conj(z1)) ; 
