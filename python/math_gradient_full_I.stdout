const complex_type DI_coeff_1 = 2*Iup*gpll*gqll*z1*z2*conj(gpll)*conj(gqll)*conj(z1)*conj(z2) + 2*Iup*gpll*gqlr*(z1 * z1)*conj(gplr)*conj(gqll)*(conj(z2) * conj(z2)) + 2*Iup*gpll*gqrl*z1*z2*conj(gpll)*conj(gqrl)*conj(z1)*conj(z2) + 2*Iup*gpll*gqrr*(z1 * z1)*conj(gplr)*conj(gqrl)*(conj(z2) * conj(z2)) + 2*Iup*gplr*gqll*(z2 * z2)*conj(gpll)*conj(gqlr)*(conj(z1) * conj(z1)) + 2*Iup*gplr*gqlr*z1*z2*conj(gplr)*conj(gqlr)*conj(z1)*conj(z2) + 2*Iup*gplr*gqrl*(z2 * z2)*conj(gpll)*conj(gqrr)*(conj(z1) * conj(z1)) + 2*Iup*gplr*gqrr*z1*z2*conj(gplr)*conj(gqrr)*conj(z1)*conj(z2) + 2*Iup*gprl*gqll*z1*z2*conj(gprl)*conj(gqll)*conj(z1)*conj(z2) + 2*Iup*gprl*gqlr*(z1 * z1)*conj(gprr)*conj(gqll)*(conj(z2) * conj(z2)) + 2*Iup*gprl*gqrl*z1*z2*conj(gprl)*conj(gqrl)*conj(z1)*conj(z2) + 2*Iup*gprl*gqrr*(z1 * z1)*conj(gprr)*conj(gqrl)*(conj(z2) * conj(z2)) + 2*Iup*gprr*gqll*(z2 * z2)*conj(gprl)*conj(gqlr)*(conj(z1) * conj(z1)) + 2*Iup*gprr*gqlr*z1*z2*conj(gprr)*conj(gqlr)*conj(z1)*conj(z2) + 2*Iup*gprr*gqrl*(z2 * z2)*conj(gprl)*conj(gqrr)*(conj(z1) * conj(z1)) + 2*Iup*gprr*gqrr*z1*z2*conj(gprr)*conj(gqrr)*conj(z1)*conj(z2) ; 
