-------------------------
const complex_type Dgplr_coeff_gpll = (Iup * Iup)*gqlr*(z1 * z1)*conj(gqll)*(conj(z2) * conj(z2)) + (Iup * Iup)*gqrr*(z1 * z1)*conj(gqrl)*(conj(z2) * conj(z2)) ; 
