-------------------------
const complex_type Dgqlr_coeff_gqlr = (Iup * Iup)*gplr*z1*z2*conj(gplr)*conj(z1)*conj(z2) + (Iup * Iup)*gprr*z1*z2*conj(gprr)*conj(z1)*conj(z2) ; 
