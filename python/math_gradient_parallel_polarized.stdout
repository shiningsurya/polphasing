-----MODELFORWARDPASS----
RR
gprr*lprl*mll*cgqrr*clqrl + gprr*lprl*mlr*cgqrr + gprr*mrl*cgqrr*clqrl + gprr*mrr*cgqrr
RL
gprr*lprl*mll*cgqll + gprr*lprl*mlr*cgqll*clqlr + gprr*mrl*cgqll + gprr*mrr*cgqll*clqlr
LR
gpll*lplr*mrl*cgqrr*clqrl + gpll*lplr*mrr*cgqrr + gpll*mll*cgqrr*clqrl + gpll*mlr*cgqrr
LL
gpll*lplr*mrl*cgqll + gpll*lplr*mrr*cgqll*clqlr + gpll*mll*cgqll + gpll*mlr*cgqll*clqlr
-----MODELFORWARDPASS----
######################################
need to edit norm(g[p,q][rr,ll]) terms
######################################

---------- GPRR   ------------

const complex_type Dgprr_dpqrr_gqrr = -lqrl*clprl*cmll - lqrl*cmrl - clprl*cmlr - cmrr ; 
Dgprr_dpqrr_gqrr*gqrr 
const complex_type Dgprr_dpqrl_gqll = -lqlr*clprl*cmlr - lqlr*cmrr - clprl*cmll - cmrl ; 
Dgprr_dpqrl_gqll*gqll 
const complex_type Dgprr_gprr_gqll*cgqll = lprl*lqlr*mll*clprl*cmlr + lprl*lqlr*mll*cmrr + lprl*lqlr*mlr*clprl*clqlr*cmlr + lprl*lqlr*mlr*clqlr*cmrr + lprl*mll*clprl*cmll + lprl*mll*cmrl + lprl*mlr*clprl*clqlr*cmll + lprl*mlr*clqlr*cmrl + lqlr*mrl*clprl*cmlr + lqlr*mrl*cmrr + lqlr*mrr*clprl*clqlr*cmlr + lqlr*mrr*clqlr*cmrr + mrl*clprl*cmll + mrl*cmrl + mrr*clprl*clqlr*cmll + mrr*clqlr*cmrl ; 
const complex_type Dgprr_gprr_gqrr*cgqrr = lprl*lqrl*mll*clprl*clqrl*cmll + lprl*lqrl*mll*clqrl*cmrl + lprl*lqrl*mlr*clprl*cmll + lprl*lqrl*mlr*cmrl + lprl*mll*clprl*clqrl*cmlr + lprl*mll*clqrl*cmrr + lprl*mlr*clprl*cmlr + lprl*mlr*cmrr + lqrl*mrl*clprl*clqrl*cmll + lqrl*mrl*clqrl*cmrl + lqrl*mrr*clprl*cmll + lqrl*mrr*cmrl + mrl*clprl*clqrl*cmlr + mrl*clqrl*cmrr + mrr*clprl*cmlr + mrr*cmrr ; 
Dgprr_gprr_gqll*cgqll*gqll*cgqll Dgprr_gprr_gqrr*cgqrr*gqrr*cgqrr 

---------- GQRR   ------------

const complex_type Dgqrr_cdpqrr_gprr = -lprl*mll*clqrl - lprl*mlr - mrl*clqrl - mrr ; 
Dgqrr_cdpqrr_gprr*gprr 
const complex_type Dgqrr_cdpqlr_gpll = -lplr*mrl*clqrl - lplr*mrr - mll*clqrl - mlr ; 
Dgqrr_cdpqlr_gpll*gpll 
