GPRR
M_{I}^{2} g_p^{rr} \left(g_q^{lr} \overline{g_q^{lr}} + g_q^{rr} \overline{g_q^{rr}}\right)+- M_{I} d_{pq}^{rr} g_q^{rr} z_{a}+- M_{I} d_{pq}^{rl} g_q^{lr} z_{a}+M_{I}^{2} g_p^{rl} z_{a}^{2} \left(g_q^{lr} \overline{g_q^{ll}} + g_q^{rr} \overline{g_q^{rl}}\right)
GPRL
M_{I}^{2} g_p^{rl} \left(g_q^{ll} \overline{g_q^{ll}} + g_q^{rl} \overline{g_q^{rl}}\right)+- M_{I} d_{pq}^{rr} g_q^{rl} z_{b}+- M_{I} d_{pq}^{rl} g_q^{ll} z_{b}+M_{I}^{2} g_p^{rr} z_{b}^{2} \left(g_q^{ll} \overline{g_q^{lr}} + g_q^{rl} \overline{g_q^{rr}}\right)
GPLR
M_{I}^{2} g_p^{lr} \left(g_q^{lr} \overline{g_q^{lr}} + g_q^{rr} \overline{g_q^{rr}}\right)+- M_{I} d_{pq}^{lr} g_q^{rr} z_{a}+- M_{I} d_{pq}^{ll} g_q^{lr} z_{a}+M_{I}^{2} g_p^{ll} z_{a}^{2} \left(g_q^{lr} \overline{g_q^{ll}} + g_q^{rr} \overline{g_q^{rl}}\right)
GPLL
M_{I}^{2} g_p^{ll} \left(g_q^{ll} \overline{g_q^{ll}} + g_q^{rl} \overline{g_q^{rl}}\right)+- M_{I} d_{pq}^{lr} g_q^{rl} z_{b}+- M_{I} d_{pq}^{ll} g_q^{ll} z_{b}+M_{I}^{2} g_p^{lr} z_{b}^{2} \left(g_q^{ll} \overline{g_q^{lr}} + g_q^{rl} \overline{g_q^{rr}}\right)
GQRR
M_{I}^{2} g_q^{rr} \left(g_p^{lr} \overline{g_p^{lr}} + g_p^{rr} \overline{g_p^{rr}}\right)+- M_{I} g_p^{lr} z_{b} \overline{d_{pq}^{lr}}+- M_{I} g_p^{rr} z_{b} \overline{d_{pq}^{rr}}+M_{I}^{2} g_q^{rl} z_{b}^{2} \left(g_p^{lr} \overline{g_p^{ll}} + g_p^{rr} \overline{g_p^{rl}}\right)
GQRL
M_{I}^{2} g_q^{rl} \left(g_p^{ll} \overline{g_p^{ll}} + g_p^{rl} \overline{g_p^{rl}}\right)+- M_{I} g_p^{ll} z_{a} \overline{d_{pq}^{lr}}+- M_{I} g_p^{rl} z_{a} \overline{d_{pq}^{rr}}+M_{I}^{2} g_q^{rr} z_{a}^{2} \left(g_p^{ll} \overline{g_p^{lr}} + g_p^{rl} \overline{g_p^{rr}}\right)
GQLR
M_{I}^{2} g_q^{lr} \left(g_p^{lr} \overline{g_p^{lr}} + g_p^{rr} \overline{g_p^{rr}}\right)+- M_{I} g_p^{lr} z_{b} \overline{d_{pq}^{ll}}+- M_{I} g_p^{rr} z_{b} \overline{d_{pq}^{rl}}+M_{I}^{2} g_q^{ll} z_{b}^{2} \left(g_p^{lr} \overline{g_p^{ll}} + g_p^{rr} \overline{g_p^{rl}}\right)
GQLL
M_{I}^{2} g_q^{ll} \left(g_p^{ll} \overline{g_p^{ll}} + g_p^{rl} \overline{g_p^{rl}}\right)+- M_{I} g_p^{ll} z_{a} \overline{d_{pq}^{ll}}+- M_{I} g_p^{rl} z_{a} \overline{d_{pq}^{rl}}+M_{I}^{2} g_q^{lr} z_{a}^{2} \left(g_p^{ll} \overline{g_p^{lr}} + g_p^{rl} \overline{g_p^{rr}}\right)
-----MODELFORWARDPASS----
RR
MI*gprl*exp(1j*theta1)*exp(-1j*theta2)*cgqrl + MI*gprr*exp(-1j*theta1)*exp(1j*theta2)*cgqrr
RL
MI*gprl*exp(1j*theta1)*exp(-1j*theta2)*cgqll + MI*gprr*exp(-1j*theta1)*exp(1j*theta2)*cgqlr
LR
MI*gpll*exp(1j*theta1)*exp(-1j*theta2)*cgqrl + MI*gplr*exp(-1j*theta1)*exp(1j*theta2)*cgqrr
LL
MI*gpll*exp(1j*theta1)*exp(-1j*theta2)*cgqll + MI*gplr*exp(-1j*theta1)*exp(1j*theta2)*cgqlr
